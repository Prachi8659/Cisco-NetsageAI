# NetSage AI - Environment Configuration Example

# Backend Settings
PROJECT_NAME="NetSage AI"
DATABASE_URL="sqlite:///./netsage.db"
# Or PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/netsage"

# AI Provider Settings (Backend-only, never exposed to client)
AI_PROVIDER="mock" # options: "mock", "openai"
AI_API_KEY=""
SECRET_KEY="netsage_development_secret_key_change_in_production"

# Frontend Settings
VITE_API_URL="http://localhost:8000/api"
