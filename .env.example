# NetSage AI - Environment Configuration Example

# ====================================================
# Backend Environment Variables (Render Web Service)
# ====================================================
PROJECT_NAME="NetSage AI"
DATABASE_URL="sqlite:///./netsage.db"

# AI Diagnosis Provider ("gemini", "mock", "openai")
AI_PROVIDER="gemini"
AI_API_KEY="your_gemini_api_key_here"
AI_MODEL="gemini-3.1-flash-lite"
AI_TIMEOUT_SECONDS="30"

# Optional Custom Data & PKT Storage Paths
# DATA_DIR="/var/data"
# PKT_STORAGE_DIR="/var/data/pkt_uploads"

# ====================================================
# Frontend Environment Variables (Render Static Site)
# ====================================================
# In local development: "http://localhost:8000/api"
# In Render production: "https://<your-backend-service-name>.onrender.com/api"
VITE_API_URL="http://localhost:8000/api"
